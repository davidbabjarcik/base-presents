# Copy this file to .env and fill it in. .env is never committed.

# Stripe TEST secret key (Stripe Dashboard → Developers → API keys, with "Test mode" on).
# Leave empty to run in DEMO mode with a simulated payment page.
# Live keys (sk_live_...) are refused on purpose.
STRIPE_SECRET_KEY=

# Optional: webhook signing secret from `stripe listen` (makes paid orders count even if the buyer closes the tab)
STRIPE_WEBHOOK_SECRET=

# Team accounts, created on the first start (later change passwords in Admin → Users).
# admin = everything, tickets = ticket sales + scanner + promo + ideas, team = stock + promo + stats + ideas
ADMIN_EMAIL=base@base.com
ADMIN_PASSWORD=
TICKETS_EMAIL=listky@base.com
TICKETS_PASSWORD=
STAFF_EMAIL=staff@base.com
STAFF_PASSWORD=

# Public website address (its ticket form talks to this server)
SITE_URL=http://localhost:8765

PORT=4242
BASE_URL=http://localhost:4242

EVENT_NAME=Chodbovica 5
EVENT_DATE=16.11.2026 · 21:07
EVENT_VENUE=Jedlíkova 7, Košice
TICKET_NAME=Presale
TICKET_PRICE_CENTS=1000
EVENT_CAPACITY=1400
MAX_PER_ORDER=6
